[Unit]
Description=cirunner - on-demand GitHub Actions runner pool
# systemd 用户服务（`systemctl --user enable --now cirunner`）。
# WSL2 需 /etc/wsl.conf 里 systemd=true。守护迁移到常驻机时原样可用。

[Service]
ExecStart=%h/cirunner/bin/cirunner -config %h/.config/cirunner/cirunner.json daemon
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
